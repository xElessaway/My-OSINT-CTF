---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import CTFAnswerValidator from "../../../components/CTFAnswerValidator.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/Icon.astro";

export async function getStaticPaths() {
  const challenges = await getCollection("ctfChallenges");

  return challenges.map((entry) => ({
    params: {
      collection: entry.data.collection,
      challenge: entry.slug
    },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const collections = await getCollection("ctfCollections");
const collection = collections.find((item) => item.slug === entry.data.collection);
const challengeImage = entry.data.image ?? entry.data.assets.find((asset) => asset.kind === "image")?.url;
const flagArchive = entry.data.assets.find(
  (asset) => asset.kind === "archive" || asset.label.toLowerCase().includes("flag archive")
);
const hasBody = Boolean(entry.body && entry.body.trim().length > 0 && entry.body.trim() !== "Add challenge notes here.");
const promptHtml = await marked.parse(entry.data.prompt || "");
---

<BaseLayout
  title={`${entry.data.title} | ${collection?.data.title ?? "Practice Lab"}`}
  description={entry.data.prompt}
>
  <div class="article-dossier-container">
    <!-- Top Back Navigation Bar -->
    <nav class="article-breadcrumb-bar">
      <a href={collection ? `/ctf/${collection.slug}/` : "/ctf/"} class="article-back-link">
        <Icon name="arrow_back" size={16} />
        <span>Back to {collection?.data.title ?? "Practice Set"}</span>
      </a>
      <span class="article-doc-id">CHALLENGE_ID: {entry.slug.toUpperCase()}</span>
    </nav>

    <!-- Mission Brief Header -->
    <header class="article-dossier-header">
      <div class="article-tape-sticker" aria-hidden="true"></div>
      <div class="article-meta-ribbon">
        <span class="article-type-pill">Challenge Brief</span>
        <span class:list={["difficulty-chip", entry.data.difficulty]}>{entry.data.difficulty.toUpperCase()}</span>
      </div>

      <h1 class="article-title">{entry.data.title}</h1>
      <div class="article-lede challenge-prompt-prose" set:html={promptHtml} />

      {
        challengeImage && (
          <figure class="challenge-brief-figure">
            <img src={challengeImage} alt={entry.data.title} class="challenge-image" data-zoomable-image />
            <figcaption class="challenge-image-caption">Mission Artifact Exhibit: Click image to expand</figcaption>
          </figure>
        )
      }
    </header>

    <!-- Main Challenge Manuscript / Body (if present) -->
    {
      hasBody && (
        <main class="article-manuscript-panel challenge-manuscript-panel">
          <div class="article-prose prose">
            <Content />
          </div>
        </main>
      )
    }

    <!-- Mission Operational Strip & Validator -->
    <section class="challenge-mission-panel">
      <div class="challenge-metadata-grid">
        <div class="challenge-meta-card">
          <span class="meta-card-label">PRACTICE SET</span>
          <strong class="meta-card-value">{collection?.data.title ?? entry.data.collection}</strong>
        </div>
        <div class="challenge-meta-card">
          <span class="meta-card-label">EVIDENCE ASSET</span>
          {
            flagArchive ? (
              <a class="challenge-download-link" href={flagArchive.url} target="_blank" rel="noopener noreferrer">
                <Icon name="download" size={16} />
                <span>{flagArchive.label}</span>
              </a>
            ) : (
              <span class="meta-card-text">Included in prompt</span>
            )
          }
        </div>
      </div>

      <div class="challenge-validator-box">
        <CTFAnswerValidator
          collection={entry.data.collection}
          challenge={entry.slug}
          passwordFormat={entry.data.passwordFormat}
          answerHashes={entry.data.answerHashes}
          acceptedAliases={entry.data.acceptedAliases}
          hint={entry.data.hint}
        />
      </div>
    </section>
  </div>
</BaseLayout>
