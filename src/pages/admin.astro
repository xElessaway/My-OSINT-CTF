        const formActors = document.getElementById("form-actors");
        const formCtf = document.getElementById("form-ctf");

        if (formBlog) formBlog.style.display = type === "blog" ? "block" : "none";
        if (formActors) formActors.style.display = type === "actors" ? "block" : "none";
        if (formCtf) formCtf.style.display = type === "ctf" ? "block" : "none";

        resetToNewPost();
      });
    });

    // Live Preview
    function updatePreview() {
      const previewTitle = document.getElementById("preview-title");
      const previewDesc = document.getElementById("preview-desc");
      const previewBody = document.getElementById("preview-body");

      if (currentStudioMode === "actors") {
        if (previewTitle) previewTitle.textContent = actorNameInput.value.trim() || "Threat Intel Dossier";
        if (previewDesc) previewDesc.textContent = actorMotivationInput.value.trim() || "Motivation summary...";
      } else if (currentStudioMode === "ctf") {
        if (previewTitle) previewTitle.textContent = ctfTitleInput.value.trim() || "CTF Challenge";
        if (previewDesc) {
          const rawPrompt = ctfPromptInput.value.trim() || "Mission prompt...";
          if (typeof marked !== "undefined") {
            previewDesc.innerHTML = marked.parse(rawPrompt);
          } else {
            previewDesc.textContent = rawPrompt;
          }
        }
      } else {
        if (previewTitle) previewTitle.textContent = titleInput.value.trim() || "Untitled Article";
        if (previewDesc) previewDesc.textContent = descInput.value.trim() || "Description summary...";
      }

      if (previewBody && typeof marked !== "undefined") {
        previewBody.innerHTML = marked.parse(editor.value || "<p><em>Start writing to preview rendered content...</em></p>");
        previewBody.querySelectorAll("table").forEach((table) => {
          if (table.parentElement && !table.parentElement.classList.contains("table-responsive-wrap")) {
            const wrap = document.createElement("div");
            wrap.className = "table-responsive-wrap";
            table.parentNode.insertBefore(wrap, table);
            wrap.appendChild(table);
          }
        });
      }
    }

    [titleInput, slugInput, descInput, actorNameInput, actorSlugInput, actorMotivationInput, ctfTitleInput, ctfSlugInput, ctfPromptInput, editor].forEach((el) => {
