    // Automatic Clipboard Paste Screenshot -> GitHub Upload
    editor?.addEventListener("paste", async (e) => {
      const items = (e.clipboardData || window.clipboardData)?.items;
      if (!items) return;

      for (let i = 0; i < items.length; i++) {
