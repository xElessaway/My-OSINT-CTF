      if (!token) {
        tokenVerifyMsg.textContent = "⚠️ Please enter a token.";
        tokenVerifyMsg.style.color = "var(--alert)";
        return;
      }

      tokenVerifyMsg.textContent = "Verifying with GitHub...";
      tokenVerifyMsg.style.color = "var(--primary)";

      try {
        const res = await fetch("https://api.github.com/user", {
          headers: { Authorization: `Bearer ${token}` }
        });
        if (res.ok) {
          const user = await res.json();
          localStorage.setItem(TOKEN_KEY, token);
          tokenVerifyMsg.textContent = `✅ Connected as ${user.login}`;
          tokenVerifyMsg.style.color = "#10b981";
          checkAuthStatus();
          setTimeout(() => tokenDialog?.close(), 800);
        } else {
          tokenVerifyMsg.textContent = "❌ Invalid Token or expired.";
          tokenVerifyMsg.style.color = "var(--alert)";
        }
      } catch (e) {
        tokenVerifyMsg.textContent = `❌ Verification error: ${e.message}`;
        tokenVerifyMsg.style.color = "var(--alert)";
