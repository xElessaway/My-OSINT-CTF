    // Library Rendering
    function renderLibrary(filterText = "") {
      const query = filterText.trim().toLowerCase();
      let combined = [
        ...libraryPosts.map((p) => ({ ...p, __type: "blog" })),
        ...libraryActors.map((a) => ({ ...a, __type: "actors" })),
        ...libraryCtf.map((c) => ({ ...c, __type: "ctf" }))
      ];

      // Sort by timestamp descending (newest on top)
      combined.sort((a, b) => (b._timestamp || 0) - (a._timestamp || 0));

      if (currentFilterType !== "all") {
        combined = combined.filter((i) => i.__type === currentFilterType);
      }

      const filtered = combined.filter((item) => {
        const title = item.title || item.name || "";
        const slug = item.slug || "";
        const tags = (item.tags || []).join(" ");
        return !query || title.toLowerCase().includes(query) || slug.toLowerCase().includes(query) || tags.toLowerCase().includes(query);
      });

      if (!libraryList) return;

      if (filtered.length === 0) {
        libraryList.innerHTML = `<div style="padding: 2rem; text-align: center; color: var(--text-muted);">No matching content found.</div>`;
        return;
      }

      libraryList.innerHTML = filtered.map((item) => {
        const typeLabels = { blog: "ARTICLE", actors: "DOSSIER", ctf: "CTF" };
        const label = typeLabels[item.__type] || item.__type.toUpperCase();
        const dateDisplay = item._dateStr ? `<span class="library-item-date">${item._dateStr}</span>` : "";
        return `
          <div class="library-item-card">
            <div class="library-item-info">
              <div class="library-item-meta">
                <span class="dossier-type-tag ${item.__type}">${label}</span>
                <strong class="library-item-name">${item.title || item.name}</strong>
                ${dateDisplay}
              </div>
              <span class="library-item-slug">src/content/${item.__type === "ctf" ? "ctfChallenges" : item.__type}/${item.slug}.md</span>
            </div>
            <div class="library-item-actions">
              <button type="button" class="btn-edit" onclick="window._loadItem('${item.slug}', '${item.__type}')">EDIT</button>
              <button type="button" class="btn-delete" onclick="window._confirmDelete('${item.slug}', '${(item.title || item.name).replace(/'/g, "\\'")}', '${item.__type}')">DELETE</button>
            </div>
          </div>
        `;
      }).join("");
    }

    window._loadItem = (slug, type) => {
      let list = libraryPosts;
      if (type === "actors") list = libraryActors;
      if (type === "ctf") list = libraryCtf;
      const item = list.find((p) => p.slug === slug);
      if (item) loadPostIntoEditor(item, type);
    };

    let pendingDeleteSlug = "";
    let pendingDeleteType = "blog";
    window._confirmDelete = (slug, title, type = "blog") => {
      pendingDeleteSlug = slug;
      pendingDeleteType = type;
      const folder = type === "ctf" ? "ctfChallenges" : type;
      if (deleteTargetTitle) deleteTargetTitle.textContent = `${title} (${folder}/${slug}.md)`;
      deleteDialog?.showModal();
    };

    // Filter chips
    document.querySelectorAll(".filter-chip").forEach((chip) => {
