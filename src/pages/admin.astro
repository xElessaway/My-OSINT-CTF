      if (!alertBox || !alertMsg) return;
      alertMsg.textContent = msg;
      alertBox.style.display = "block";
      alertBox.className = `studio-alert ${type}`;
      clearTimeout(alertTimer);
      alertTimer = setTimeout(() => {
        alertBox.style.display = "none";
