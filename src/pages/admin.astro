    }

    // Auth helpers
    function getStoredToken() {
      return localStorage.getItem(TOKEN_KEY) || "";
    }

    async function checkAuthStatus() {
      const token = getStoredToken();
      if (!token) {
        if (authStatusDot) authStatusDot.className = "auth-status-dot is-off";
        if (authStatusText) authStatusText.textContent = "Token Required";
        return false;
      }

      if (authStatusDot) authStatusDot.className = "auth-status-dot is-checking";
      if (authStatusText) authStatusText.textContent = "Verifying...";

      try {
        const res = await fetch("https://api.github.com/user", {
          headers: { Authorization: `Bearer ${token}` }
        });
        if (res.ok) {
          const user = await res.json();
          if (authStatusDot) authStatusDot.className = "auth-status-dot is-on";
          if (authStatusText) authStatusText.textContent = `Connected (${user.login})`;
          return true;
        } else {
          if (authStatusDot) authStatusDot.className = "auth-status-dot is-off";
          if (authStatusText) authStatusText.textContent = "Invalid Token";
          return false;
        }
      } catch (e) {
        if (authStatusDot) authStatusDot.className = "auth-status-dot is-off";
        if (authStatusText) authStatusText.textContent = "Offline";
        return false;
      }
    }

    tokenModalOpen?.addEventListener("click", () => {
