---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

function getFileTimestamp(relPath: string): number {
  try {
    const fullPath = path.join(process.cwd(), relPath);
    if (fs.existsSync(fullPath)) {
      return fs.statSync(fullPath).mtimeMs;
    }
  } catch (e) {}
  return 0;
}

function formatDate(timestampOrStr: number | string): string {
  if (!timestampOrStr) return "";
  const d = new Date(timestampOrStr);
  if (isNaN(d.getTime())) return String(timestampOrStr);
  return d.toISOString().split("T")[0];
}

const blogPosts = (await getCollection("blog")).map((p) => {
  const fileTime = getFileTimestamp(`src/content/blog/${p.slug}.md`);
  const pubTime = p.data.publishedAt ? new Date(p.data.publishedAt).getTime() : 0;
  const ts = Math.max(pubTime, fileTime) || Date.now();
  return {
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    publishedAt: p.data.publishedAt ? p.data.publishedAt.toISOString().split("T")[0] : formatDate(ts),
    archiveSection: p.data.archiveSection,
    tags: p.data.tags,
    cover: p.data.cover || "",
    featured: p.data.featured,
    draft: p.data.draft,
    sourceLabel: p.data.sourceLabel || "",
    sourceUrl: p.data.sourceUrl || "",
    body: p.body,
    _timestamp: ts,
    _dateStr: p.data.publishedAt ? p.data.publishedAt.toISOString().split("T")[0] : formatDate(ts)
  };
}).sort((a, b) => b._timestamp - a._timestamp);

const actorList = (await getCollection("actors")).map((a) => {
  const fileTime = getFileTimestamp(`src/content/actors/${a.slug}.md`);
  const ts = fileTime || Date.now();
  return {
    slug: a.slug,
    name: a.data.name,
    aliases: a.data.aliases || [],
    status: a.data.status,
    origin: a.data.origin,
    motivation: a.data.motivation,
    targets: a.data.targets || [],
    firstSeen: a.data.firstSeen,
    lastSeen: a.data.lastSeen,
    tools: a.data.tools || [],
    ttps: a.data.ttps || [],
    tags: a.data.tags || [],
    timeline: a.data.timeline || [],
    references: a.data.references || [],
    relatedPosts: a.data.relatedPosts || [],
    featured: a.data.featured || false,
    body: a.body,
    _timestamp: ts,
    _dateStr: a.data.lastSeen ? `Seen: ${a.data.lastSeen}` : formatDate(ts)
  };
}).sort((a, b) => b._timestamp - a._timestamp);

const ctfChallenges = (await getCollection("ctfChallenges")).map((c) => {
  const fileTime = getFileTimestamp(`src/content/ctfChallenges/${c.slug}.md`);
  const ts = fileTime || Date.now();
  return {
    slug: c.slug,
    collection: c.data.collection,
    title: c.data.title,
    difficulty: c.data.difficulty,
    prompt: c.data.prompt,
    passwordFormat: c.data.passwordFormat,
    hint: c.data.hint || "",
    order: c.data.order,
    answerHashes: c.data.answerHashes,
    body: c.body,
    _timestamp: ts,
    _dateStr: formatDate(ts)
  };
}).sort((a, b) => b._timestamp - a._timestamp);

const existingPostsJson = JSON.stringify(blogPosts).replace(/</g, "\\u003c");
const existingActorsJson = JSON.stringify(actorList).replace(/</g, "\\u003c");
const existingCtfJson = JSON.stringify(ctfChallenges).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Inked Intel Studio | Ahmed Elessaway"
  description="In-browser publishing and management studio for research articles, threat dossiers, and CTF challenges."
  robots="noindex,nofollow"
>
  <div class="studio-wrapper">
    <!-- Studio Header -->
    <header class="studio-header">
      <div class="studio-header-title">
        <div class="status-stamp"><span></span>Studio Mode Active</div>
        <h1 class="studio-heading">
          INKED INTEL STUDIO
          <svg class="archive-squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 5 Q 50 10 100 0" fill="transparent" stroke="currentColor" stroke-width="4"></path>
          </svg>
        </h1>
      </div>

      <!-- Controls & Auth Status -->
      <div class="studio-top-controls">
        <button type="button" class="button button-ghost" id="library-modal-open">
          <Icon name="policy" size={16} />
          Content Library (<span id="library-count">{blogPosts.length + actorList.length + ctfChallenges.length}</span>)
        </button>

        <div class="studio-auth-box">
          <div class="studio-auth-status" id="auth-status-indicator">
            <span class="auth-status-dot" id="auth-status-dot"></span>
            <span id="auth-status-text">Checking Token...</span>
          </div>
          <button type="button" class="button button-ghost studio-token-btn" id="token-modal-open">
            Configure Token
          </button>
        </div>
      </div>
    </header>

    <!-- Studio Navigation Tabs & Actions -->
    <div class="studio-nav-bar">
      <div class="studio-content-tabs">
        <button type="button" class="studio-tab is-active" data-type="blog">
          <Icon name="terminal" size={16} />
          Research Article
        </button>
        <button type="button" class="studio-tab" data-type="actors">
          <Icon name="shield" size={16} />
          Threat Intel Dossier
        </button>
        <button type="button" class="studio-tab" data-type="ctf">
          <Icon name="flag" size={16} />
          CTF Challenge
        </button>
      </div>

      <div class="studio-actions-top">
        <button type="button" class="button button-ghost" id="studio-import-btn" title="Import from Medium or Web and auto-format">
          <Icon name="magic" size={16} /> Import
        </button>
        <button type="button" class="button button-ghost" id="studio-new-btn">
          <Icon name="add" size={16} /> New Item
        </button>
        <button type="button" class="button button-ghost" id="studio-save-draft">
          <Icon name="save" size={16} /> Save Draft
        </button>
        <button type="button" class="button button-primary studio-publish-btn" id="studio-publish-btn">
          <Icon name="rocket_launch" size={16} /> Publish
        </button>
      </div>
    </div>

    <!-- Status Toast Alert -->
    <div id="studio-alert" class="studio-alert" style="display: none;">
      <span id="studio-alert-msg">Ready.</span>
    </div>

    <!-- Split Editor Canvas -->
    <div class="studio-canvas">
      <!-- Left: Form Pane -->
      <div class="studio-form-pane">
        <!-- 1. Metadata Form for Research Article (Blog) -->
        <div id="form-blog" class="studio-meta-group">
          <div class="studio-input-grid">
            <label class="studio-field studio-field-wide">
              <span class="studio-label">Article Title *</span>
              <input type="text" id="post-title" class="studio-input" placeholder="e.g. Dissecting Exposed Cobalt Strike & Adaptix C2 Infrastructure..." />
            </label>

            <label class="studio-field">
              <span class="studio-label">File Slug (URL) *</span>
              <input type="text" id="post-slug" class="studio-input mono" placeholder="auto-generated-slug" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Section Lane</span>
              <select id="post-section" class="studio-input">
                <option value="reports">Investigation Report</option>
                <option value="writeups">CTF Writeup</option>
              </select>
            </label>

            <label class="studio-field studio-field-wide">
              <span class="studio-label">Short Description / Lede *</span>
              <textarea id="post-desc" class="studio-input" rows="2" placeholder="Brief 1-2 sentence executive summary..."></textarea>
            </label>

            <label class="studio-field">
              <span class="studio-label">Tags (comma separated)</span>
              <input type="text" id="post-tags" class="studio-input" placeholder="threat-intelligence, dfir, cobalt-strike" value="threat-intelligence, dfir" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Cover Image URL (optional)</span>
              <input type="text" id="post-cover" class="studio-input" placeholder="/images/uploads/..." />
            </label>

            <label class="studio-field">
              <span class="studio-label">Publish Date</span>
              <input type="date" id="post-date" class="studio-input" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Original Source URL</span>
              <input type="url" id="post-source-url" class="studio-input" placeholder="https://medium.com/..." />
            </label>

            <div class="studio-field-checkboxes">
              <label class="studio-checkbox-label">
                <input type="checkbox" id="post-featured" />
                <span>Featured Investigation</span>
              </label>
              <label class="studio-checkbox-label">
                <input type="checkbox" id="post-draft" />
                <span>Save as Draft</span>
              </label>
            </div>
          </div>
        </div>

        <!-- 2. Metadata Form for Threat Intel Dossiers (Actors) -->
        <div id="form-actors" class="studio-meta-group" style="display: none;">
          <div class="studio-input-grid">
            <label class="studio-field studio-field-wide">
              <span class="studio-label">Actor / Cluster Name *</span>
              <input type="text" id="actor-name" class="studio-input" placeholder="e.g. RedHydra Adaptix & Cobalt Strike Cluster" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Dossier Slug (URL) *</span>
              <input type="text" id="actor-slug" class="studio-input mono" placeholder="redhydra-adaptix-cluster" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Tracking Status *</span>
              <select id="actor-status" class="studio-input">
                <option value="active">Active (Ongoing)</option>
                <option value="tracking">Tracking</option>
                <option value="disrupted">Disrupted</option>
                <option value="historic">Historic</option>
              </select>
            </label>

            <label class="studio-field">
              <span class="studio-label">Origin / Theater *</span>
              <input type="text" id="actor-origin" class="studio-input" placeholder="e.g. China / Asia-Pacific" value="Unknown" />
            </label>

            <label class="studio-field">
              <span class="studio-label">First Seen (YYYY-MM)</span>
              <input type="text" id="actor-first-seen" class="studio-input" placeholder="2026-05" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Last Seen (YYYY-MM)</span>
              <input type="text" id="actor-last-seen" class="studio-input" placeholder="2026-08" />
            </label>

            <label class="studio-field studio-field-wide">
              <span class="studio-label">Motivation &amp; Objectives *</span>
              <textarea id="actor-motivation" class="studio-input" rows="2" placeholder="e.g. Targeted reconnaissance, access brokerage, and exploitation..."></textarea>
            </label>

            <label class="studio-field">
              <span class="studio-label">Known Aliases (comma separated)</span>
              <input type="text" id="actor-aliases" class="studio-input" placeholder="RedHydra-C2, UNC-10142" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Targeted Sectors (comma separated)</span>
              <input type="text" id="actor-targets" class="studio-input" placeholder="Healthcare, Municipal Portals" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Tooling Arsenal (comma separated)</span>
              <input type="text" id="actor-tools" class="studio-input" placeholder="Cobalt Strike 4.9.1, AdaptixC2, Rogue MySQL" />
            </label>

            <label class="studio-field">
              <span class="studio-label">MITRE ATT&amp;CK TTPs (comma separated)</span>
              <input type="text" id="actor-ttps" class="studio-input" placeholder="T1190, T1552.001, T1562.001" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Tags (comma separated)</span>
              <input type="text" id="actor-tags" class="studio-input" placeholder="cobalt-strike, threat-actor" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Related Report Slugs (comma separated)</span>
              <input type="text" id="actor-related-posts" class="studio-input" placeholder="dissecting-exposed-adaptix-c2-and-rogue-mysql-exploitation-infrastructure" />
            </label>

            <div class="studio-field-checkboxes">
              <label class="studio-checkbox-label">
                <input type="checkbox" id="actor-featured" />
                <span>Featured Dossier</span>
              </label>
            </div>
          </div>
        </div>

        <!-- 3. Metadata Form for CTF Challenges -->
        <div id="form-ctf" class="studio-meta-group" style="display: none;">
          <div class="studio-input-grid">
            <label class="studio-field studio-field-wide">
              <span class="studio-label">Challenge Title *</span>
              <input type="text" id="ctf-title" class="studio-input" placeholder="e.g. Operation Luminous Stag" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Challenge Slug (URL) *</span>
              <input type="text" id="ctf-slug" class="studio-input mono" placeholder="operation-luminous-stag" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Collection Lane *</span>
              <select id="ctf-collection" class="studio-input">
                <option value="discord-challenges">Discord Challenges</option>
                <option value="osint-1">OSINT Collection 1</option>
              </select>
            </label>

            <label class="studio-field">
              <span class="studio-label">Difficulty *</span>
              <select id="ctf-difficulty" class="studio-input">
                <option value="easy">Easy</option>
                <option value="medium">Medium</option>
                <option value="hard">Hard</option>
              </select>
            </label>

            <label class="studio-field">
              <span class="studio-label">Display Order (Integer)</span>
              <input type="number" id="ctf-order" class="studio-input" value="1" min="1" />
            </label>

            <label class="studio-field studio-field-wide">
              <span class="studio-label">Challenge Mission Prompt *</span>
              <textarea id="ctf-prompt" class="studio-input" rows="2" placeholder="Analyze the forensic memory dump or certificate trail..."></textarea>
            </label>

            <label class="studio-field">
              <span class="studio-label">Flag Format *</span>
              <input type="text" id="ctf-format" class="studio-input mono" placeholder="e.g. CTF{...} or plain string" value="CTF{...}" />
            </label>

            <label class="studio-field">
              <span class="studio-label">Hint (Optional)</span>
              <input type="text" id="ctf-hint" class="studio-input" placeholder="Check the SAN certificate extensions..." />
            </label>

            <label class="studio-field studio-field-wide">
              <span class="studio-label">Accepted Flag Plaintext or SHA-256 Hashes (comma separated) *</span>
              <input type="text" id="ctf-answers" class="studio-input mono" placeholder="e.g. CTF{secret_flag}, CTF{alternate_flag}" />
            </label>
          </div>
        </div>

        <!-- Markdown Toolbar -->
        <div class="studio-toolbar">
          <button type="button" class="toolbar-btn" data-tool="h2">H2</button>
          <button type="button" class="toolbar-btn" data-tool="h3">H3</button>
          <button type="button" class="toolbar-btn" data-tool="bold"><strong>B</strong></button>
          <button type="button" class="toolbar-btn" data-tool="italic"><em>I</em></button>
          <button type="button" class="toolbar-btn" data-tool="quote">Quote</button>
          <button type="button" class="toolbar-btn" data-tool="code">Code</button>
          <button type="button" class="toolbar-btn" data-tool="table">Table</button>
          <button type="button" class="toolbar-btn toolbar-defang-btn" data-tool="defang">🛡️ Defang</button>
          <label class="toolbar-btn toolbar-upload-btn">
            <span>📷 Upload Image</span>
            <input type="file" id="image-file-input" accept="image/*" style="display: none;" />
          </label>
        </div>

        <!-- Markdown Editor Area -->
        <div class="studio-editor-area">
          <textarea id="markdown-editor" class="studio-editor-textarea" spellcheck="false" placeholder="Write markdown content here... (Tip: You can press Ctrl+V anywhere in this editor to paste and auto-upload screenshots directly!)"></textarea>
        </div>
      </div>

      <!-- Right: Live Preview Pane -->
      <div class="studio-preview-pane">
        <div class="studio-preview-header">
          <span class="preview-badge">LIVE PREVIEW</span>
          <span class="studio-preview-tag" id="editing-indicator">New Post Mode</span>
        </div>
        <div class="studio-paper-container">
          <div class="preview-card-box">
            <h1 class="preview-heading" id="preview-title">Untitled</h1>
            <p class="preview-subhead" id="preview-desc">Summary will appear here...</p>
          </div>
          <div class="preview-prose-box prose" id="preview-body">
            <p><em>Start writing to preview rendered content...</em></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Library Modal Dialog -->
  <dialog id="library-dialog" class="studio-dialog studio-dialog-large">
    <div class="studio-dialog-content">
      <div class="studio-dialog-head">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <Icon name="policy" size={22} />
          <h3 style="margin: 0; font-size: 1.3rem;">Content Library</h3>
        </div>
        <button type="button" class="modal-close-btn" id="library-dialog-close">✕</button>
      </div>

      <div class="library-toolbar">
        <input type="search" id="library-search" class="studio-input" placeholder="Search by title, slug, or tags..." autocomplete="off" />
        <div class="library-filter-chips">
          <button type="button" class="filter-chip is-active" data-filter="all">All</button>
          <button type="button" class="filter-chip" data-filter="blog">Articles</button>
          <button type="button" class="filter-chip" data-filter="actors">Threat Dossiers</button>
          <button type="button" class="filter-chip" data-filter="ctf">CTF Challenges</button>
        </div>
      </div>

      <div class="library-items-list" id="library-list"></div>
    </div>
  </dialog>

  <!-- Delete Dialog -->
  <dialog id="delete-dialog" class="studio-dialog">
    <div class="studio-dialog-content">
      <div class="studio-dialog-head">
        <h3 style="color: var(--alert); margin: 0;">Confirm GitHub Deletion</h3>
        <button type="button" class="modal-close-btn" id="delete-dialog-close">✕</button>
      </div>
      <p style="font-size: 0.95rem; line-height: 1.5; color: var(--text); margin: 1rem 0 1.5rem;">
        Are you sure you want to permanently delete <strong id="delete-target-title">this item</strong> from your GitHub repository?
      </p>
      <div class="button-row" style="justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="button button-ghost" id="delete-cancel-btn">Cancel</button>
        <button type="button" class="button button-primary" id="delete-confirm-btn" style="background: var(--alert); border-color: var(--alert);">Delete from GitHub</button>
      </div>
    </div>
  </dialog>

  <!-- GitHub Token Dialog -->
  <dialog id="token-dialog" class="studio-dialog">
    <div class="studio-dialog-content">
      <div class="studio-dialog-head">
        <h3 style="margin: 0;">Configure GitHub Token</h3>
        <button type="button" class="modal-close-btn" id="token-dialog-close">✕</button>
      </div>
      <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin: 0.75rem 0 1.25rem;">
        Enter a GitHub Personal Access Token (PAT) with <code>repo</code> write access. Your token is stored locally in your browser and used to push markdown files and screenshots.
      </p>
      <label class="studio-field studio-field-wide">
        <span class="studio-label">Personal Access Token (classic or fine-grained)</span>
        <input type="password" id="github-token-input" class="studio-input mono" placeholder="ghp_... or github_pat_..." autocomplete="off" />
      </label>
      <div class="button-row" style="justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
        <button type="button" class="button button-ghost" id="token-clear-btn">Clear</button>
        <button type="button" class="button button-primary" id="token-save-btn">Verify &amp; Save</button>
      </div>
      <p id="token-verify-msg" style="font-size: 0.85rem; font-weight: 700; margin: 0.75rem 0 0;"></p>
    </div>
  </dialog>

  <!-- Smart Importer Dialog -->
  <dialog id="import-dialog" class="studio-dialog studio-dialog-large">
    <div class="studio-dialog-content">
      <div class="studio-dialog-head">
        <h3 style="margin: 0;">Smart Article Importer</h3>
        <button type="button" class="modal-close-btn" id="import-dialog-close">✕</button>
      </div>
      <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0.5rem 0 1rem;">
        Paste HTML or Markdown from Medium, Substack, or your notes. Headings, code blocks, figures, and quotes are automatically parsed and formatted.
      </p>
      <label class="studio-field studio-field-wide">
        <span class="studio-label">Paste Content (HTML or Markdown)</span>
        <textarea id="import-raw-input" class="studio-input mono" rows="8" placeholder="Paste full text or HTML from Medium here..."></textarea>
      </label>
      <div style="margin-top: 0.75rem;">
        <label class="studio-checkbox-label">
          <input type="checkbox" id="import-auto-defang" checked />
          <span>Auto-defang malicious URLs and IP addresses</span>
        </label>
      </div>
      <div class="button-row" style="justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
        <button type="button" class="button button-ghost" id="import-cancel-btn">Cancel</button>
        <button type="button" class="button button-primary" id="import-process-btn">Process &amp; Load into Editor</button>
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" id="studio-seed-posts" set:html={existingPostsJson}></script>
  <script is:inline type="application/json" id="studio-seed-actors" set:html={existingActorsJson}></script>
  <script is:inline type="application/json" id="studio-seed-ctf" set:html={existingCtfJson}></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <script is:inline>
    const GITHUB_OWNER = "xElessaway";
    const GITHUB_REPO = "xElessaway.github.io";
    const GITHUB_BRANCH = "main";
    const TOKEN_KEY = "xelessaway_gh_token";

    let libraryPosts = [];
    let libraryActors = [];
    let libraryCtf = [];
    try {
      libraryPosts = JSON.parse(document.getElementById("studio-seed-posts")?.textContent || "[]");
      libraryActors = JSON.parse(document.getElementById("studio-seed-actors")?.textContent || "[]");
      libraryCtf = JSON.parse(document.getElementById("studio-seed-ctf")?.textContent || "[]");
    } catch (e) {
      console.error("Failed to parse seed data", e);
    }

    let currentStudioMode = "blog";
    let currentOriginalSlug = "";
    let currentFilterType = "all";

    // Form Elements
    const titleInput = document.getElementById("post-title");
    const slugInput = document.getElementById("post-slug");
    const descInput = document.getElementById("post-desc");
    const sectionInput = document.getElementById("post-section");
    const tagsInput = document.getElementById("post-tags");
    const coverInput = document.getElementById("post-cover");
    const dateInput = document.getElementById("post-date");
    const sourceUrlInput = document.getElementById("post-source-url");
    const featuredCheck = document.getElementById("post-featured");
    const draftCheck = document.getElementById("post-draft");

    const actorNameInput = document.getElementById("actor-name");
    const actorSlugInput = document.getElementById("actor-slug");
    const actorStatusInput = document.getElementById("actor-status");
    const actorOriginInput = document.getElementById("actor-origin");
    const actorFirstSeenInput = document.getElementById("actor-first-seen");
    const actorLastSeenInput = document.getElementById("actor-last-seen");
    const actorMotivationInput = document.getElementById("actor-motivation");
    const actorAliasesInput = document.getElementById("actor-aliases");
    const actorTargetsInput = document.getElementById("actor-targets");
    const actorToolsInput = document.getElementById("actor-tools");
    const actorTtpsInput = document.getElementById("actor-ttps");
    const actorTagsInput = document.getElementById("actor-tags");
