    function parseYamlString(yamlText) {
      const data = {};
      const lines = yamlText.split(/\r?\n/);
      let currentKey = null;
      let currentArray = null;

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith("#")) continue;

        // List item
        if (line.match(/^\s*-\s+/)) {
          const val = line.replace(/^\s*-\s+/, "").trim().replace(/^["']|["']$/g, "");
          if (currentKey && currentArray) {
            currentArray.push(val);
          }
          continue;
        }

        // Key-value pair
        const kvMatch = line.match(/^([a-zA-Z0-9_-]+):\s*(.*)$/);
        if (kvMatch) {
          const key = kvMatch[1];
          let val = kvMatch[2].trim();

          if (!val) {
            currentKey = key;
            currentArray = [];
            data[key] = currentArray;
          } else if (val.startsWith("[") && val.endsWith("]")) {
            try {
              data[key] = JSON.parse(val);
            } catch (e) {
              data[key] = val.slice(1, -1).split(",").map((s) => s.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
            }
            currentKey = null;
            currentArray = null;
          } else {
            val = val.replace(/^["']|["']$/g, "");
            if (val === "true") data[key] = true;
            else if (val === "false") data[key] = false;
            else data[key] = val;
            currentKey = null;
            currentArray = null;
          }
        }
      }
      return data;
    }

    // Smart Importer Dialog
    importBtn?.addEventListener("click", () => importDialog?.showModal());
    importDialogClose?.addEventListener("click", () => importDialog?.close());
    importCancelBtn?.addEventListener("click", () => importDialog?.close());

    importProcessBtn?.addEventListener("click", () => {
      let raw = importRawInput?.value || "";
      if (!raw.trim()) {
        showAlert("⚠️ Paste content to import first.", "alert");
        return;
      }

      if (importAutoDefang?.checked) {
        raw = defangIOCs(raw);
      }

      // 1. Check for YAML Frontmatter (Markdown files)
      const frontmatterMatch = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
      if (frontmatterMatch) {
        const yamlBlock = frontmatterMatch[1];
        const bodyContent = frontmatterMatch[2].trim();
        const meta = parseYamlString(yamlBlock);

        // Detect if this is an Actor Dossier or a Blog Post
        const isActor = !!(meta.name || meta.motivation || meta.origin || meta.tools || meta.ttps || meta.aliases);
        const isCtf = !!(meta.collection || meta.prompt || meta.passwordFormat || meta.answerHashes);

        if (isActor) {
          // Switch tab to actors
          document.querySelectorAll(".studio-tab").forEach((t) => t.classList.remove("is-active"));
          const actorTab = document.querySelector('.studio-tab[data-type="actors"]');
          actorTab?.classList.add("is-active");
          currentStudioMode = "actors";

          const formBlog = document.getElementById("form-blog");
          const formActors = document.getElementById("form-actors");
          const formCtf = document.getElementById("form-ctf");
          if (formBlog) formBlog.style.display = "none";
          if (formActors) formActors.style.display = "block";
          if (formCtf) formCtf.style.display = "none";

          if (actorNameInput) actorNameInput.value = meta.name || "";
          if (actorSlugInput) actorSlugInput.value = meta.slug || generateSlug(meta.name || "cluster");
          if (actorStatusInput && meta.status) actorStatusInput.value = meta.status;
          if (actorOriginInput) actorOriginInput.value = meta.origin || "Unknown / Threat Staging Infrastructure";
          if (actorFirstSeenInput) actorFirstSeenInput.value = meta.firstSeen || "2026-08";
          if (actorLastSeenInput) actorLastSeenInput.value = meta.lastSeen || "2026-08";
          if (actorMotivationInput) actorMotivationInput.value = meta.motivation || "";
          if (actorAliasesInput) actorAliasesInput.value = Array.isArray(meta.aliases) ? meta.aliases.join(", ") : (meta.aliases || "");
          if (actorTargetsInput) actorTargetsInput.value = Array.isArray(meta.targets) ? meta.targets.join(", ") : (meta.targets || "");
          if (actorToolsInput) actorToolsInput.value = Array.isArray(meta.tools) ? meta.tools.join(", ") : (meta.tools || "");
          if (actorTtpsInput) actorTtpsInput.value = Array.isArray(meta.ttps) ? meta.ttps.join(", ") : (meta.ttps || "");
          if (actorTagsInput) actorTagsInput.value = Array.isArray(meta.tags) ? meta.tags.join(", ") : (meta.tags || "");
          if (actorRelatedPostsInput) actorRelatedPostsInput.value = Array.isArray(meta.relatedPosts) ? meta.relatedPosts.join(", ") : (meta.relatedPosts || "");
          if (actorFeaturedCheck) actorFeaturedCheck.checked = !!meta.featured;
        } else if (isCtf) {
          // Switch tab to CTF
          document.querySelectorAll(".studio-tab").forEach((t) => t.classList.remove("is-active"));
          const ctfTab = document.querySelector('.studio-tab[data-type="ctf"]');
          ctfTab?.classList.add("is-active");
          currentStudioMode = "ctf";

          const formBlog = document.getElementById("form-blog");
          const formActors = document.getElementById("form-actors");
          const formCtf = document.getElementById("form-ctf");
          if (formBlog) formBlog.style.display = "none";
          if (formActors) formActors.style.display = "none";
          if (formCtf) formCtf.style.display = "block";

          if (ctfTitleInput) ctfTitleInput.value = meta.title || "";
          if (ctfSlugInput) ctfSlugInput.value = meta.slug || generateSlug(meta.title || "challenge");
          if (ctfCollectionInput && meta.collection) ctfCollectionInput.value = meta.collection;
          if (ctfDifficultyInput && meta.difficulty) ctfDifficultyInput.value = meta.difficulty;
          if (ctfPromptInput) ctfPromptInput.value = meta.prompt || "";
          if (ctfFormatInput) ctfFormatInput.value = meta.passwordFormat || "";
          if (ctfHintInput) ctfHintInput.value = meta.hint || "";
          if (ctfAnswersInput) ctfAnswersInput.value = Array.isArray(meta.answerHashes) ? meta.answerHashes.join(", ") : (meta.answerHashes || "");
        } else {
          // Switch tab to Blog
          document.querySelectorAll(".studio-tab").forEach((t) => t.classList.remove("is-active"));
          const blogTab = document.querySelector('.studio-tab[data-type="blog"]');
          blogTab?.classList.add("is-active");
          currentStudioMode = "blog";

          const formBlog = document.getElementById("form-blog");
          const formActors = document.getElementById("form-actors");
          const formCtf = document.getElementById("form-ctf");
          if (formBlog) formBlog.style.display = "block";
          if (formActors) formActors.style.display = "none";
          if (formCtf) formCtf.style.display = "none";

          if (titleInput) titleInput.value = meta.title || "";
          if (slugInput) slugInput.value = meta.slug || generateSlug(meta.title || "article");
          if (descInput) descInput.value = meta.description || "";
          if (dateInput && meta.publishedAt) dateInput.value = meta.publishedAt;
          if (coverInput && meta.cover) coverInput.value = meta.cover;
          if (sectionInput && meta.archiveSection) sectionInput.value = meta.archiveSection;
          if (tagsInput) tagsInput.value = Array.isArray(meta.tags) ? meta.tags.join(", ") : (meta.tags || "");
          if (featuredCheck) featuredCheck.checked = !!meta.featured;
          if (draftCheck) draftCheck.checked = !!meta.draft;
        }

        if (editor) editor.value = bodyContent;
        updatePreview();
        importDialog?.close();
        showAlert("✅ Frontmatter parsed and loaded cleanly into form & editor!", "info");
        return;
      }

      if (raw.includes("<") && raw.includes(">")) {
        raw = raw
          .replace(/<h1[^>]*>(.*?)<\/h1>/gi, "\n\n# $1\n\n")
          .replace(/<h2[^>]*>(.*?)<\/h2>/gi, "\n\n## $1\n\n")
          .replace(/<h3[^>]*>(.*?)<\/h3>/gi, "\n\n### $1\n\n")
          .replace(/<h4[^>]*>(.*?)<\/h4>/gi, "\n\n#### $1\n\n")
          .replace(/<strong[^>]*>(.*?)<\/strong>/gi, "**$1**")
          .replace(/<b[^>]*>(.*?)<\/b>/gi, "**$1**")
          .replace(/<em[^>]*>(.*?)<\/em>/gi, "*$1*")
          .replace(/<i[^>]*>(.*?)<\/i>/gi, "*$1*")
          .replace(/<blockquote[^>]*>(.*?)<\/blockquote>/gis, "\n\n> $1\n\n")
          .replace(/<pre[^>]*><code[^>]*>(.*?)<\/code><\/pre>/gis, "\n\n```\n$1\n```\n\n")
          .replace(/<code[^>]*>(.*?)<\/code>/gi, "`$1`")
          .replace(/<p[^>]*>(.*?)<\/p>/gis, "\n\n$1\n\n")
          .replace(/<li[^>]*>(.*?)<\/li>/gi, "\n- $1")
          .replace(/<ul[^>]*>(.*?)<\/ul>/gis, "$1\n")
          .replace(/<ol[^>]*>(.*?)<\/ol>/gis, "$1\n");
      }

      if (editor) editor.value = raw.trim();
      updatePreview();
      importDialog?.close();
      showAlert("✅ Content parsed and loaded into editor!", "info");
    });

    // Publishing to GitHub
    async function publishContent(isDraft = false) {
      const token = getStoredToken();
      if (!token) {
        showAlert("⚠️ Configure your GitHub Token before publishing.", "alert");
        tokenDialog?.showModal();
        return;
      }

      publishBtn.disabled = true;
      if (saveDraftBtn) saveDraftBtn.disabled = true;
      showAlert("🚀 Committing to GitHub...", "info");

      try {
        let targetPath = "";
        let markdownContent = "";
        let itemTitle = "";
        let itemSlug = "";

        if (currentStudioMode === "actors") {
          itemTitle = actorNameInput.value.trim() || "Untitled Dossier";
          itemSlug = actorSlugInput.value.trim() || generateSlug(itemTitle);
          targetPath = `src/content/actors/${itemSlug}.md`;

          const aliases = actorAliasesInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          const targets = actorTargetsInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          const tools = actorToolsInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          const ttps = actorTtpsInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          const tags = actorTagsInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          const relatedPosts = actorRelatedPostsInput.value.split(",").map((s) => s.trim()).filter(Boolean);

          markdownContent = `---
name: "${itemTitle}"
aliases: ${JSON.stringify(aliases)}
status: "${actorStatusInput.value}"
origin: "${actorOriginInput.value}"
motivation: "${actorMotivationInput.value.replace(/"/g, '\\"')}"
targets: ${JSON.stringify(targets)}
firstSeen: "${actorFirstSeenInput.value || "2026-05"}"
lastSeen: "${actorLastSeenInput.value || "2026-08"}"
tools: ${JSON.stringify(tools)}
ttps: ${JSON.stringify(ttps)}
tags: ${JSON.stringify(tags)}
relatedPosts: ${JSON.stringify(relatedPosts)}
featured: ${actorFeaturedCheck.checked}
---

${editor.value}`;
        } else if (currentStudioMode === "ctf") {
          itemTitle = ctfTitleInput.value.trim() || "Untitled CTF Challenge";
          itemSlug = ctfSlugInput.value.trim() || generateSlug(itemTitle);
          targetPath = `src/content/ctfChallenges/${itemSlug}.md`;

          const rawAnswers = ctfAnswersInput.value.split(",").map((s) => s.trim()).filter(Boolean);
          // Auto hash answers if needed or store directly
          const answerHashes = rawAnswers;

          markdownContent = `---
collection: ${JSON.stringify(ctfCollectionInput.value || "discord-challenges")}
title: ${JSON.stringify(itemTitle)}
difficulty: ${JSON.stringify(ctfDifficultyInput.value || "medium")}
prompt: ${JSON.stringify(ctfPromptInput.value)}
passwordFormat: ${JSON.stringify(ctfFormatInput.value.trim())}
hint: ${JSON.stringify(ctfHintInput.value.trim())}
answerHashes: ${JSON.stringify(answerHashes)}
order: ${parseInt(ctfOrderInput.value, 10) || 1}
---

${editor.value}`;
        } else {
          itemTitle = titleInput.value.trim() || "Untitled Article";
          itemSlug = slugInput.value.trim() || generateSlug(itemTitle);
          targetPath = `src/content/blog/${itemSlug}.md`;

          const tags = tagsInput.value.split(",").map((s) => s.trim()).filter(Boolean);

          markdownContent = `---
title: "${itemTitle.replace(/"/g, '\\"')}"
description: "${descInput.value.replace(/"/g, '\\"')}"
publishedAt: ${dateInput.value || new Date().toISOString().split("T")[0]}
archiveSection: ${sectionInput.value || "reports"}
tags: ${JSON.stringify(tags)}
cover: "${coverInput.value.trim()}"
featured: ${featuredCheck.checked}
draft: ${isDraft}
sourceUrl: "${sourceUrlInput.value.trim()}"
---

${editor.value}`;
        }

        let fileSha = undefined;
        try {
          const checkRes = await fetch(`https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/contents/${targetPath}?ref=${GITHUB_BRANCH}`, {
            headers: { Authorization: `Bearer ${token}` }
          });
          if (checkRes.ok) {
            const existingFile = await checkRes.json();
            fileSha = existingFile.sha;
          }
        } catch (e) {}

        markdownContent = sanitizeStudioSecrets(markdownContent);
        const utf8Bytes = new TextEncoder().encode(markdownContent);
        let binary = "";
        for (let i = 0; i < utf8Bytes.length; i++) {
          binary += String.fromCharCode(utf8Bytes[i]);
        }
        const base64Content = btoa(binary);

        const putBody = {
          message: `Publish ${targetPath} via Inked Intel Studio`,
          content: base64Content,
          branch: GITHUB_BRANCH
        };
        if (fileSha) {
          putBody.sha = fileSha;
        }

        const putRes = await fetch(`https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/contents/${targetPath}`, {
          method: "PUT",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify(putBody)
        });

        if (putRes.ok) {
          showAlert(`🎉 Published to GitHub! (${targetPath})`, "info");
          currentOriginalSlug = itemSlug;
          if (editingIndicator) editingIndicator.textContent = `Live: ${targetPath}`;

          const now = Date.now();
          const nowStr = new Date().toISOString().split("T")[0];

          if (currentStudioMode === "actors") {
            const existingIdx = libraryActors.findIndex((a) => a.slug === itemSlug);
            const updatedItem = {
              slug: itemSlug,
              name: itemTitle,
              aliases: actorAliasesInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              status: actorStatusInput.value,
              origin: actorOriginInput.value,
              motivation: actorMotivationInput.value,
              targets: actorTargetsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              firstSeen: actorFirstSeenInput.value,
              lastSeen: actorLastSeenInput.value,
              tools: actorToolsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              ttps: actorTtpsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              tags: actorTagsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              relatedPosts: actorRelatedPostsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              featured: actorFeaturedCheck.checked,
              body: editor.value,
              _timestamp: now,
              _dateStr: actorLastSeenInput.value ? `Seen: ${actorLastSeenInput.value}` : nowStr
            };
            if (existingIdx >= 0) libraryActors.splice(existingIdx, 1);
            libraryActors.unshift(updatedItem);
          } else if (currentStudioMode === "ctf") {
            const rawAnswers = ctfAnswersInput.value.split(",").map((s) => s.trim()).filter(Boolean);
            const existingIdx = libraryCtf.findIndex((c) => c.slug === itemSlug);
            const updatedItem = {
              slug: itemSlug,
              collection: ctfCollectionInput.value,
              title: itemTitle,
              difficulty: ctfDifficultyInput.value,
              prompt: ctfPromptInput.value,
              passwordFormat: ctfFormatInput.value.trim(),
              hint: ctfHintInput.value.trim(),
              order: parseInt(ctfOrderInput.value, 10) || 1,
              answerHashes: rawAnswers,
              body: editor.value,
              _timestamp: now,
              _dateStr: nowStr
            };
            if (existingIdx >= 0) libraryCtf.splice(existingIdx, 1);
            libraryCtf.unshift(updatedItem);
          } else {
            const existingIdx = libraryPosts.findIndex((p) => p.slug === itemSlug);
            const updatedItem = {
              slug: itemSlug,
              title: itemTitle,
              description: descInput.value,
              publishedAt: dateInput.value || nowStr,
              archiveSection: sectionInput.value || "reports",
              tags: tagsInput.value.split(",").map((s) => s.trim()).filter(Boolean),
              cover: coverInput.value.trim(),
              featured: featuredCheck.checked,
              draft: isDraft,
              sourceUrl: sourceUrlInput.value.trim(),
              body: editor.value,
              _timestamp: now,
              _dateStr: dateInput.value || nowStr
            };
            if (existingIdx >= 0) libraryPosts.splice(existingIdx, 1);
            libraryPosts.unshift(updatedItem);
          }

          const libraryCountEl = document.getElementById("library-count");
          if (libraryCountEl) libraryCountEl.textContent = libraryPosts.length + libraryActors.length + libraryCtf.length;
        } else {
          const err = await putRes.json().catch(() => ({}));
          if (putRes.status === 404) {
            showAlert("❌ 404 Not Found: Ensure your GitHub Token has 'repo' / 'Contents: Read & Write' permission on xElessaway/xElessaway.github.io.", "alert");
          } else {
            showAlert(`❌ Publish failed: ${err.message || "GitHub API Error"}`, "alert");
          }
        }
      } catch (err) {
        showAlert(`❌ Error publishing: ${err.message}`, "alert");
      } finally {
        publishBtn.disabled = false;
        if (saveDraftBtn) saveDraftBtn.disabled = false;
      }
    }

    publishBtn?.addEventListener("click", () => publishContent(false));
    saveDraftBtn?.addEventListener("click", () => publishContent(true));

    checkAuthStatus();
    updatePreview();
  </script>

