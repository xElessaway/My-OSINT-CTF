      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1rem;
      border: none;
      background: transparent;
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--text-muted);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .studio-tab.is-active {
      background: var(--primary);
      color: #fff;
      box-shadow: 1px 1px 0 rgba(0,0,0,0.2);
    }

    .studio-actions-top {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Alert Box */
    .studio-alert {
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 800;
      margin-bottom: 1.25rem;
      border: var(--ink-border);
      box-shadow: var(--ink-shadow-sm);
      background: var(--secondary-soft);
      color: var(--secondary);
    }
    .studio-alert.alert {
      background: var(--alert-soft);
      color: var(--alert);
    }

    /* Split Canvas */
    .studio-canvas {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    @media (max-width: 1024px) {
      .studio-canvas {
        grid-template-columns: 1fr;
      }
    }

    /* Form Pane */
    .studio-form-pane {
      background: var(--surface);
      border: var(--ink-border);
      box-shadow: var(--ink-shadow);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .studio-input-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .studio-field-wide {
      grid-column: 1 / -1;
    }

    .studio-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .studio-label {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .studio-input {
      width: 100%;
      background: var(--surface-low);
      border: var(--ink-border);
      border-radius: 6px;
      padding: 0.65rem 0.85rem;
      color: var(--text);
      font-size: 0.92rem;
      font-family: inherit;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .studio-input:focus {
      outline: none;
      border-color: var(--secondary);
      box-shadow: var(--ink-shadow-red-lg);
    }

    .studio-input.mono {
      font-family: var(--font-mono);
    }

    .studio-field-checkboxes {
      grid-column: 1 / -1;
      display: flex;
      gap: 1.5rem;
      padding-top: 0.5rem;
    }

    .studio-checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 800;
      cursor: pointer;
      color: var(--text);
    }

    /* Toolbar */
    .studio-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem;
      background: var(--surface-panel);
      border: var(--ink-border);
      border-radius: 8px;
    }

    .toolbar-btn {
      padding: 0.35rem 0.7rem;
      background: var(--surface);
      border: var(--ink-border);
      box-shadow: 1px 1px 0 var(--line);
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--text);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      transition: transform 0.1s ease;
    }

    .toolbar-btn:hover {
      transform: translate(-1px, -1px);
    }

    .toolbar-defang-btn {
      background: var(--secondary-soft);
      color: var(--secondary);
      border-color: var(--secondary);
    }

    .studio-editor-textarea {
      width: 100%;
      min-height: 480px;
      background: var(--surface-low);
      border: var(--ink-border);
      border-radius: 8px;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--text);
      resize: vertical;
    }

    .studio-editor-textarea:focus {
      outline: none;
      border-color: var(--secondary);
      box-shadow: var(--ink-shadow-red-lg);
    }

    /* Live Preview Pane */
    .studio-preview-pane {
      background: var(--surface);
      border: var(--ink-border);
      box-shadow: var(--ink-shadow);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      overflow-x: hidden;
      min-width: 0;
    }

    .studio-preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1rem;
      border-bottom: var(--ink-border);
      margin-bottom: 1.25rem;
    }

    .preview-badge {
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      color: var(--secondary);
    }

    .studio-preview-tag {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      font-weight: 800;
      color: var(--text-muted);
      background: var(--surface-panel);
      border: var(--ink-border);
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
    }

    .preview-card-box {
      border: var(--ink-border);
      border-left: 6px solid var(--secondary);
      border-radius: 8px;
      padding: 1.25rem;
      background: var(--surface-low);
      margin-bottom: 1.25rem;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .preview-heading {
      font-size: clamp(1.3rem, 2vw, 1.6rem);
      font-weight: 900;
      margin: 0 0 0.5rem;
      color: var(--text);
      overflow-wrap: break-word;
      word-break: break-word;
      line-height: 1.2;
    }

    .preview-subhead {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin: 0;
      line-height: 1.5;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .preview-prose-box {
      padding: 1rem;
      border: var(--ink-border);
      border-radius: 8px;
      background: var(--surface);
      min-height: 250px;
      overflow-wrap: break-word;
      word-break: break-word;
      min-width: 0;
    }

    .preview-prose-box h1,
    .preview-prose-box h2,
    .preview-prose-box h3,
    .preview-prose-box h4 {
      overflow-wrap: break-word;
      word-break: break-word;
      line-height: 1.25;
    }

    .preview-prose-box h1 {
      font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    }

    .preview-prose-box h2 {
      font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    }

    .preview-prose-box h3 {
      font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    }

    .preview-prose-box p,
    .preview-prose-box li,
    .preview-prose-box blockquote {
      overflow-wrap: break-word;
      word-break: break-word;
    }

    /* Table styling in live preview - fills full width with no empty gaps */
    .preview-prose-box .table-responsive-wrap {
      width: 100%;
      overflow-x: auto;
      margin: 1.25rem 0;
      border: 2px solid var(--primary);
      border-radius: 6px;
      background: var(--surface-low);
      box-shadow: 2px 2px 0 var(--primary);
    }

    .preview-prose-box table {
      width: 100%;
      min-width: 100%;
      margin: 0;
      border-collapse: collapse;
      border: none;
      display: table;
      font-size: 0.88rem;
    }

    .preview-prose-box th,
    .preview-prose-box td {
      padding: 0.75rem 1rem;
      border: 1px solid var(--line-soft);
      text-align: left;
      vertical-align: middle;
    }

    .preview-prose-box th {
      background: var(--surface-panel);
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 700;
      color: var(--text);
    }

    /* Dialogs - SOLID, OPAQUE & CLEAN */
    .studio-dialog {
      border: var(--ink-border-heavy) !important;
      box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.4) !important;
      border-radius: 12px;
      background: var(--surface) !important;
      color: var(--text);
      padding: 0;
      max-width: 580px;
      width: 90vw;
      opacity: 1 !important;
    }

    .studio-dialog::backdrop {
      background: rgba(0, 0, 0, 0.75) !important;
      backdrop-filter: blur(4px);
    }

    .studio-dialog-large {
      max-width: 820px;
    }

    .studio-dialog-content {
      background: var(--surface);
      padding: 1.75rem;
    }

    .studio-dialog-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1rem;
      border-bottom: var(--ink-border);
      margin-bottom: 1.25rem;
    }

    .modal-close-btn {
      background: var(--surface);
      border: var(--ink-border);
      box-shadow: 2px 2px 0 var(--line);
      width: 32px;
      height: 32px;
      border-radius: 6px;
      font-weight: 900;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--text);
      transition: transform 0.1s ease;
    }

    .modal-close-btn:hover {
      transform: translate(-1px, -1px);
    }

    /* Library Toolbar & List */
    .library-toolbar {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .library-filter-chips {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .filter-chip {
      background: var(--surface-low);
      border: var(--ink-border);
      border-radius: 6px;
      padding: 0.3rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--text-muted);
      cursor: pointer;
      box-shadow: 1px 1px 0 var(--line);
    }

    .filter-chip.is-active {
      background: var(--secondary);
      color: #fff;
      border-color: var(--secondary);
    }

    .library-items-list {
      max-height: 420px;
      overflow-y: auto;
      border: var(--ink-border);
      border-radius: 8px;
      background: var(--surface-low);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.5rem;
    }

    .library-item-card {
      background: var(--surface);
      border: var(--ink-border);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      box-shadow: 2px 2px 0 var(--line);
    }

    .library-item-info {
      flex: 1;
      min-width: 0;
    }

    .library-item-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .library-item-name {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 400px;
    }

    .library-item-slug {
      display: block;
      font-size: 0.78rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .library-item-date {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--text-soft);
      margin-left: auto;
      padding-right: 0.5rem;
      flex-shrink: 0;
    }

    .dossier-type-tag {
      font-size: 0.68rem;
      font-weight: 900;
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      border: 1px solid var(--line);
      background: var(--surface-panel);
    }

    .dossier-type-tag.actors {
      background: var(--secondary-soft);
      color: var(--secondary);
      border-color: var(--secondary);
    }

    .dossier-type-tag.ctf {
      background: rgba(14, 165, 233, 0.15);
      color: #0284c7;
      border-color: #0284c7;
    }

    .library-item-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .btn-edit, .btn-delete {
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 900;
      cursor: pointer;
      border: var(--ink-border);
      box-shadow: 1px 1px 0 var(--line);
      transition: transform 0.1s ease;
    }

    .btn-edit {
      background: var(--surface);
      color: var(--text);
    }

    .btn-delete {
      background: var(--alert-soft);
      color: var(--alert);
      border-color: var(--alert);
    }

    .btn-edit:hover, .btn-delete:hover {
      transform: translate(-1px, -1px);
    }
  </style>
</BaseLayout>
